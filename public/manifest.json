{
  "manifest_version": 3,
  "name": "Floatspace — Productivity Workspace",
  "short_name": "Floatspace",
  "version": "0.1.0",
  "description": "A calm focus timer, tasks, notes and quick links workspace. Your data stays on this device.",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Floatspace"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
